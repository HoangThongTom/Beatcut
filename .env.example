# Copy to .env for local runs. Nothing here is required for M1.
# Path to the ffmpeg binary if it is not on PATH.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Optional: experiment tracking (M3)
WANDB_PROJECT=beatcut
WANDB_API_KEY=

# Optional: API hardening (M3)
BEATCUT_API_TOKEN=
BEATCUT_MAX_UPLOAD_MB=2048
