*.mp4
!docs/assets/montage-demo.mp4
*.mkv
*.mov
*.wav
*.mp3
*.flac

# --- Local config ---
.env
*.local.yaml

# --- Local scratch: fixtures, experiments, downloaded tools ---
scratch/
tools/
install.log

# --- OS / editors ---
.DS_Store
